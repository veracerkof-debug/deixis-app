<?xml version="1.0" encoding="utf-8"?>
<!--
  Перенос данных Android на новое устройство и облачная копия: ключ экрана (TLS), токены сопряжения и PIN-сопряжения
  не переносятся — новое устройство сопрягается заново. Библиотеку переносят копии Deixis (Настройки → Копии).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tokens.xml" />
        <exclude domain="file" path="receiver" />
        <exclude domain="file" path="screen" />
    </device-transfer>
</data-extraction-rules>
