<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Демонстрация экрана: видимая служба с уведомлением, без неё Android не даёт захватывать экран. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Связь с экранами в фоне: видимая служба «подключённое устройство» (ShowService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Режим экрана: держит устройство включённым во время показа. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Универсальная версия ставится и на телефон, и на ТВ, проектор, доску. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".PhoneApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="Deixis"
        android:supportsRtl="true"
        android:theme="@style/Theme.Deixis"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- QR-коды экранов Deixis и Holyrics: камера телефона открывает их прямо в приложении. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="deixis" />
                <data android:scheme="deixis-holyrics" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ScreenActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Deixis.Screen">
            <!-- На телевизоре приложение видно в его меню и открывается сразу экраном. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Окно приёмника на кабельном или беспроводном дисплее: своё, чтобы не гаснуть со свёрнутым пультом. -->
        <activity
            android:name=".CastActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:taskAffinity="app.deixis.phone.cast"
            android:theme="@style/Theme.Deixis.Screen" />
        <service
            android:name=".ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".ShowService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
